            "url": { "raw": "{{baseUrl}}/api/categories" }
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories" }
          }
        },
        {
          "name": "Get Category By ID",
          "request": {
            "method": "GET",
