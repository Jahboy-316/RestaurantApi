            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Appetizers\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}" }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}" }
          }
        }
      ]
    },
    {
